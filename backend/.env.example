NODE_ENV=development
DEMO_PAYMENTS_ENABLED=false
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://user:password@host:5432/database
# Development only. Production must set verify-full (also the production default).
# Verified-mode DATABASE_URL must have no query parameters, including sslmode.
DATABASE_TLS_MODE=disable
# Optional CA file from Supabase Database settings; otherwise use Node's trusted roots.
DATABASE_CA_CERT_PATH=
MERCHANT_UPI_ID=
MERCHANT_UPI_NAME=
ORDER_TRACKING_SECRET=replace-with-at-least-32-random-bytes
PENDING_PAYMENT_EXPIRY_MINUTES=30
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional comma-separated proxy IPs/CIDRs. Leave unset unless requests arrive
# through trusted proxies that overwrite the forwarded-for header.
TRUSTED_PROXY_IPS=
# Create this public bucket in Supabase Storage with a 4 MB limit and image/jpeg,
# image/png, image/webp allowed. Keep the service-role key backend-only.
MENU_STORAGE_BUCKET=menu-images

# Optional TEST ONLY. Set off/unset in production. No live keys are supported.
RAZORPAY_MODE=off
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret from the TEST webhook dashboard; never use the API key secret.
RAZORPAY_WEBHOOK_SECRET=
