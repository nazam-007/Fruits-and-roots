NODE_ENV=development
DEMO_PAYMENTS_ENABLED=false
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
# Opt-in full React SPA hosting from ../frontend/dist on the existing Express API.
# Production same-origin deployment: true; separate frontend/custom domains: false.
SERVE_FRONTEND=false
DATABASE_URL=postgresql://fruits_roots_backend:replace-with-private-password@host:5432/postgres
# Full server startup requires verify-full, including controlled local verification.
# Verified-mode DATABASE_URL must have no query parameters, including sslmode.
DATABASE_TLS_MODE=verify-full
# A configured CA is mandatory for full application startup and production pools.
DATABASE_CA_CERT_PATH=
MERCHANT_UPI_ID=
MERCHANT_UPI_NAME=
ORDER_TRACKING_SECRET=replace-with-at-least-32-random-bytes
PENDING_PAYMENT_EXPIRY_MINUTES=30
# Disabled by default. Enable only after DB readiness and legacy-record review.
PAYMENT_EXPIRY_WORKER_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional comma-separated proxy IPs/CIDRs. Leave unset unless requests arrive
# through trusted proxies that overwrite the forwarded-for header.
# Explicit addresses only; never true, hop counts, 0.0.0.0/0 or ::/0.
# Obtain the actual trusted ingress ranges before deployment; do not guess.
TRUSTED_PROXY_IPS=
# Create this public bucket in Supabase Storage with a 4 MB limit and image/jpeg,
# image/png, image/webp allowed. Keep the service-role key backend-only.
MENU_STORAGE_BUCKET=menu-images

# Optional TEST ONLY. Set off/unset in production. No live keys are supported.
RAZORPAY_MODE=off
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret from the TEST webhook dashboard; never use the API key secret.
RAZORPAY_WEBHOOK_SECRET=
