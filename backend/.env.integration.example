# Copy to .env.integration.local (ignored). Never paste real values into chat.
# No sslmode or other URL query parameters. Fill credentials privately in .local.
# session: app username fruits_roots_backend.wznkpgpexjexxzptuuwp
#          inspector username postgres.wznkpgpexjexxzptuuwp
# direct:  app username fruits_roots_backend; inspector username postgres
INTEGRATION_DATABASE_URL=
INTEGRATION_INSPECTOR_DATABASE_URL=
INTEGRATION_CONNECTION_METHOD=session
INTEGRATION_EXPECTED_PROJECT_REF=wznkpgpexjexxzptuuwp
INTEGRATION_EXPECTED_HOST=aws-0-ap-northeast-1.pooler.supabase.com
# For direct mode change method to direct and host to db.wznkpgpexjexxzptuuwp.supabase.co.
INTEGRATION_EXPECTED_DATABASE=postgres
DATABASE_TLS_MODE=verify-full
# Choose a new UUID; use the same UUID for separately approved marker setup.
INTEGRATION_RUN_ID=
# Optional trusted Supabase CA file; otherwise Node trusted roots are used.
DATABASE_CA_CERT_PATH=
# Testing-project client key and an existing testing Auth user's access token.
# No service-role key; no development credentials; never output these values.
INTEGRATION_SUPABASE_ANON_KEY=
INTEGRATION_AUTHENTICATED_ACCESS_TOKEN=
# Leave both blank until the exact target and writing command are approved.
INTEGRATION_ALLOW_WRITES=
INTEGRATION_APPROVED_PROJECT_REF=
# Required only after confirming no other application/test client uses this project.
INTEGRATION_EXCLUSIVE_ACCESS_CONFIRMED=
# Separately approved restaurant_tables fixture ID; never provisioned by the suite.
INTEGRATION_TABLE_FIXTURE_ID=
# Optional only when backend/.env is absent; exclusion identity, never a target.
SHARED_DATABASE_URL=
